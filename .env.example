# Copy this file to .env and change every value.
#
# .env is gitignored, and it is the only place a real value belongs. No real
# subdomain, host address or secret may enter any other file in this repo.

# -----------------------------------------------------------------------------
# The address
# -----------------------------------------------------------------------------

# The subdomain n8n answers on. A public DNS A record for it must already point
# at this host. traefik reads it in the Host() rule of both routers, and n8n
# reads it in the webhook URL and the editor URL — so a wrong value here gives
# you a webhook that works in the editor and fails from outside.
N8N_HOST=n8n.example.com

# The certificate resolver of the host proxy. It MUST be the same word as
# RESOLVER_NAME in the proxy's own .env. traefik issues no certificate for a
# resolver it does not hold.
RESOLVER_NAME=myresolver

# -----------------------------------------------------------------------------
# Time
# -----------------------------------------------------------------------------

# One IANA name, used twice: for the container clock, and for the timezone a
# schedule fires on. Set only the clock and every schedule stays on n8n's
# America/New_York default, silently, with an offset that moves twice a year.
TZ=Etc/UTC

# -----------------------------------------------------------------------------
# The n8n database on the Postgres server
# -----------------------------------------------------------------------------
#
# n8n reads no connection URL, so split the one your Postgres server gave you
# into the three values below. The host and the port are not here: they are the
# network alias `engine` and 5432, both pinned in docker-compose.yml.
#
# Postgres keeps no copy of the password that you can read back, so keep your
# own record of it.
#
# Before the first start, on that server:
#   ALTER ROLE <the n8n role> SET statement_timeout = '5min';
# n8n runs with DB_POSTGRESDB_STATEMENT_TIMEOUT=0, which removes its own cap, so
# without that statement one runaway query holds a server connection with no
# limit — on a server that other applications may share.
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=the-password-for-that-role

# -----------------------------------------------------------------------------
# Secrets. Generate both. Never commit the real .env
# -----------------------------------------------------------------------------

# The key that encrypts every saved credential.
#
# ONE-WAY DOOR. Lose it and every credential stops decrypting, for good: it is
# not in the database, and it cannot be derived. Generate it BEFORE the first
# start, because n8n writes its own key on an empty volume and you then have to
# find it inside the container.
#
#   openssl rand -hex 32
#
# BACK THIS FILE UP, to a secure place away from this host, and again after
# every change to it. Keep it APART from any backup of the n8n database: a
# database backup and this key in one place is one loss, not two.
N8N_ENCRYPTION_KEY=generate-me

# The shared secret between n8n and the task-runner container. Both read this
# one value.
#
#   openssl rand -hex 32
N8N_RUNNERS_AUTH_TOKEN=generate-me
